generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}
enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum PaymentMethod {
  RAZORPAY
  COD
}
enum AppointmentType {
  STORE
  HOME
}
enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}
enum PrescriptionType {
  SINGLE_VISION
  PROGRESSIVE
  ZERO_POWER
  CONTACT_LENS
}
enum PrescriptionStatus {
  DRAFT
  SAVED
  VERIFIED
}
enum DiscountType {
  PERCENTAGE
  FIXED
}
enum LensCategory {
  FRAME_ONLY
  SINGLE_VISION
  PROGRESSIVE
  ZERO_POWER
}
enum LensFeature {
  BLUE_CUT
  PHOTOCHROMIC
  ANTI_GLARE
  UV_PROTECTION
  POLARIZED
}
enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}
enum FrameShape {
  ROUND
  SQUARE
  RECTANGLE
  CAT_EYE
  AVIATOR
  WAYFARER
  OVAL
  GEOMETRIC
  RIMLESS
}
enum FrameMaterial {
  ACETATE
  METAL_TITANIUM
  TR90_STEEL
  MIXED
}
enum FrameColor {
  BLACK
  TORTOISE
  GOLD
  SILVER
  TRANSPARENT
  BLUE
  BROWN
  PINK
  GREEN
  OTHER
}

model User {
  id                String        @id @default(cuid())
  name              String?
  email             String?       @unique
  emailVerified     DateTime?
  image             String?
  phone             String?       @unique
  role              UserRole      @default(CUSTOMER)
  passwordHash      String?
  accounts          Account[]
  sessions          Session[]
  addresses         Address[]
  orders            Order[]
  prescriptions     Prescription[]
  cart              Cart?
  reviews           Review[]
  wishlist          Wishlist[]
  appointments      Appointment[]
  otpChallenges     EmailOtp[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([role, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model EmailOtp {
  id          String   @id @default(cuid())
  userId      String?
  email       String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([email, expiresAt])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  imageUrl    String?
  parentId    String?
  sortOrder   Int        @default(0)
  active      Boolean    @default(true)
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([parentId, sortOrder])
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  logoUrl     String?
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String          @db.Text
  shortDescription String?
  sku            String?         @unique
  status         ProductStatus   @default(DRAFT)
  categoryId     String
  brandId        String?
  basePrice      Decimal         @db.Decimal(10, 2)
  compareAtPrice Decimal?        @db.Decimal(10, 2)
  currency       String          @default("INR")
  gender         Gender          @default(UNISEX)
  shape          FrameShape?
  material       FrameMaterial?
  color          FrameColor?
  size           String?
  isBestseller   Boolean         @default(false)
  isNewArrival   Boolean         @default(false)
  isFeatured     Boolean         @default(false)
  prescriptionRequired Boolean   @default(false)
  seoTitle       String?
  seoDescription String?
  images         Json
  tags           String[]        @default([])
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reviews        Review[]
  wishlist       Wishlist[]
  lensSelections LensSelection[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  @@index([status, categoryId, basePrice])
  @@index([gender, shape, color])
  @@index([isBestseller, isFeatured])
  @@index([createdAt])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  sku         String   @unique
  name        String
  color       FrameColor?
  colorLabel  String?
  size        String?
  stock       Int      @default(0)
  priceDelta  Decimal  @default(0) @db.Decimal(10, 2)
  imageUrl    String?
  attributes  Json?
  active      Boolean  @default(true)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([productId, active])
}

model LensOption {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String       @db.Text
  category    LensCategory
  feature     LensFeature?
  price       Decimal      @db.Decimal(10, 2)
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  selections  LensSelection[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@index([category, active, sortOrder])
}

model LensSelection {
  id             String       @id @default(cuid())
  productId      String
  lensOptionId   String
  prescriptionId String?
  lensCategory   LensCategory
  prescription   Json?
  priceSnapshot  Decimal      @db.Decimal(10, 2)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  lensOption     LensOption   @relation(fields: [lensOptionId], references: [id], onDelete: Restrict)
  prescriptionRef Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  @@index([productId, createdAt])
}

model Prescription {
  id             String             @id @default(cuid())
  userId         String
  name           String             @default("My prescription")
  type           PrescriptionType   @default(SINGLE_VISION)
  status         PrescriptionStatus @default(DRAFT)
  odSph          Decimal?           @db.Decimal(4, 2)
  odCyl          Decimal?           @db.Decimal(4, 2)
  odAxis         Int?
  odPd           Decimal?           @db.Decimal(4, 1)
  osSph          Decimal?           @db.Decimal(4, 2)
  osCyl          Decimal?           @db.Decimal(4, 2)
  osAxis         Int?
  osPd           Decimal?           @db.Decimal(4, 1)
  addPower       Decimal?           @db.Decimal(4, 2)
  uploadUrl      String?
  notes          String?            @db.Text
  expiresAt      DateTime?
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lensSelections LensSelection[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  @@index([userId, status, updatedAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  currency  String     @default("INR")
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  @@index([updatedAt])
}

model CartItem {
  id          String         @id @default(cuid())
  cartId      String
  productId   String
  variantId   String?
  quantity    Int            @default(1)
  lensConfig  Json?
  prescriptionId String?
  cart        Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String?
  email             String
  phone             String
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  subtotal          Decimal       @db.Decimal(10, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(10, 2)
  shippingTotal     Decimal       @default(0) @db.Decimal(10, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(10, 2)
  grandTotal        Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  couponId          String?
  shippingAddress   Json
  billingAddress    Json?
  notes             String?       @db.Text
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon            Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  @@index([userId, createdAt])
  @@index([status, paymentStatus, createdAt])
  @@index([email])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  productId      String
  variantId      String?
  prescriptionId String?
  productName    String
  sku            String?
  imageUrl       String?
  quantity       Int
  unitPrice      Decimal         @db.Decimal(10, 2)
  lineTotal      Decimal         @db.Decimal(10, 2)
  lensSnapshot   Json?
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  prescription    Prescription?   @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String   @default("Home")
  fullName    String
  phone       String
  line1       String
  line2       String?
  landmark    String?
  city        String
  state       String
  postalCode  String
  country     String   @default("India")
  isDefault   Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, isDefault])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  minOrderValue  Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount    Decimal?     @db.Decimal(10, 2)
  usageLimit     Int?
  usageCount     Int          @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  active         Boolean      @default(true)
  orders         Order[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  @@index([active, startsAt, expiresAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  body      String?  @db.Text
  verified  Boolean  @default(false)
  published Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, productId])
  @@index([productId, published, createdAt])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model Store {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  address     String   @db.Text
  city        String
  state       String
  postalCode  String?
  phone       String?
  email       String?
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  openingHours Json?
  services    String[] @default([])
  active      Boolean  @default(true)
  appointments Appointment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([city, state, active])
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String?
  storeId     String?
  type        AppointmentType
  status      AppointmentStatus @default(REQUESTED)
  fullName    String
  email       String
  phone       String
  city        String?
  address     String?           @db.Text
  requestedAt DateTime
  notes       String?           @db.Text
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  store       Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}
